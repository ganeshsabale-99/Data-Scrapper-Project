  verifiedByUser      AdminUser?         @relation("CoworkingSpaceVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  owner               AdminUser?         @relation("CoworkingSpaceOwnedBy", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([state])
  @@index([state, city])
  @@index([status])
  @@index([ownerId])
}

model CoworkingCompany {
  id                          String         @id @default(cuid())
  coworkingSpaceId            String
  name                        String
  description                 String?
  operator                    String?
  contact_phone               String?
  contact_email               String?
  contact_international_phone String?
  business_status             String         @default("NOT_CONTACTED")
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt
  ContactLog                  ContactLog[]
  coworkingSpace              CoworkingSpace @relation(fields: [coworkingSpaceId], references: [id], onDelete: Cascade)

  @@index([coworkingSpaceId])
  @@index([business_status])
}

model CityCatalog {
  id        String   @id @default(cuid())
  state     String
  city      String
  is_active Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([state, city], name: "state_city_unique")
  @@index([state])
}

model ExternalApiClient {
  id          String                  @id @default(cuid())
  name        String                  @unique
  isActive    Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  keys        ExternalApiKey[]
  scopes      ExternalApiScope[]
  requestLogs ExternalApiRequestLog[]
}

model ExternalApiKey {
  id                 String                  @id @default(cuid())
  keyId              String                  @unique
  keyPrefix          String
  keyHash            String                  @unique
  isActive           Boolean                 @default(true)
  rateLimitPerMinute Int                     @default(120)
  expiresAt          DateTime?
  revokedAt          DateTime?
  lastUsedAt         DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  clientId           String
  client             ExternalApiClient       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestLogs        ExternalApiRequestLog[]

  @@index([clientId, isActive])
  @@index([expiresAt])
}

model ExternalApiScope {
  id        String            @id @default(cuid())
  clientId  String
  scope     String
  createdAt DateTime          @default(now())
  client    ExternalApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, scope], name: "external_api_client_scope_unique")
  @@index([scope])
}

model ExternalApiRequestLog {
  id         BigInt             @id @default(autoincrement())
  requestId  String?
  method     String
  path       String
  statusCode Int
  latencyMs  Int
  ip         String?
  userAgent  String?
  query      Json?
  createdAt  DateTime           @default(now())
  apiKeyId   String?
  clientId   String?
  apiKey     ExternalApiKey?    @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  client     ExternalApiClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([apiKeyId, createdAt])
  @@index([clientId, createdAt])
  @@index([path, createdAt])
}



