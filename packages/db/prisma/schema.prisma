enum AdminUserStatus {
  REGISTERED
  OTP_PENDING
  ADMIN_APPROVAL_PENDING
  ACTIVE
  REJECTED
}

enum ReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  VISIT
  CONTACTED
  NOTE
  VERIFY
}

enum Status {
  NOT_CONTACTED
  CONTACTED
  INTERESTED
  MEETING_SCHEDULED
  PROPOSAL_SENT
  IN_PROGRESS
  CLOSED
}

enum ContactLogType {
  CALL
  EMAIL
  MEETING
  DEMO
  PROPOSAL
}

enum NewsSource {
  ENTRACKR
  YOURSTORY
  VCCIRCLE
  TECHCRUNCH
  ETSTARTUP
  INC42
}

enum ActivityEntityType {
  TECH_PARK
  COMPANY
  COWORKING
  CONTACT
}

model CityAlias {
