# Database
DATABASE_URL=postgresql://user:password@host:port/dbname?schema=tech_park

# Server
PORT=8000
NODE_ENV=production
WEB_APP_URL=https://your-frontend-domain.com

# SMS & Email Services
SMS_MOCK=false
SMS_PROVIDER=flash49
GMAIL_USER=your-email@example.com
GMAIL_APP_PASSWORD=your-app-password
FLASH49_USERNAME=your-username
FLASH49_PASSWORD=your-password
FLASH49_FROM=YOURNAME
FLASH49_DLT_CONTENT_ID=

# Authentication
OTP_SECRET=your-long-random-otp-secret
SESSION_SECRET=your-long-random-session-secret
EXTERNAL_API_KEY_PEPPER=your-pepper-string

# Trial Leads (proxies gupio-website-test's external leads API)
GUPIO_LEADS_API_BASE_URL=https://your-gupio-website-server/external-api/v1
GUPIO_LEADS_API_KEY=gpk_your-issued-key

# AWS
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-south-1

# Rate Limiting & Optimization
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_STORE=memory
REDIS_URL=redis://localhost:6379
API_JSON_BODY_LIMIT=50mb
