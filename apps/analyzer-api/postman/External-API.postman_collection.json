                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}{{basePrefix}}/coworking-spaces?page=1&limit=50&state=&city=&status=&verified=&includeContacts=false",
                  "host": ["{{baseUrl}}"],
                  "path": ["{{basePrefix}}", "coworking-spaces"],
                  "query": [
                    { "key": "page", "value": "1" },
                    { "key": "limit", "value": "50" },
                    { "key": "state", "value": "" },
                    { "key": "city", "value": "" },
                    { "key": "status", "value": "" },
                    { "key": "verified", "value": "" },
                    { "key": "includeContacts", "value": "false" }
